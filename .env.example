# ==============================================================================
# ASTROLOGY WHATSAPP PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on your VPS and replace all placeholders with secure values.
# NEVER commit .env to source control!
#
# Helper commands for generating cryptographic keys:
#   256-bit Hex Key:   python -c "import secrets; print(secrets.token_hex(32))"
#   URL-safe String:   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# ── 1. CORE ENVIRONMENT ───────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── 2. POSTGRESQL DATABASE (DOCKER COMPOSE) ───────────────────────────────────
POSTGRES_DB=astrology_prod
POSTGRES_USER=astrology_user
# Generate a strong 32+ character random password:
POSTGRES_PASSWORD=replace-with-a-very-strong-database-password-32chars

# Application Database Connection Strings (automatically constructed in docker-compose)
# If running outside Docker, provide full URLs:
DATABASE_URL=postgresql+asyncpg://astrology_user:replace-with-a-very-strong-database-password-32chars@db:5432/astrology_prod
DATABASE_SYNC_URL=postgresql+psycopg://astrology_user:replace-with-a-very-strong-database-password-32chars@db:5432/astrology_prod
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ── 3. FIELD-LEVEL ENCRYPTION (AES-256-GCM) ───────────────────────────────────
# CRITICAL: 64-character hex string (32 bytes). Once set, DO NOT LOSE THIS KEY!
# All sensitive PII (phone numbers, birth details, conversation content) is encrypted with this.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_PRIMARY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_SECONDARY_KEYS={}

# ── 4. IDENTITY PSEUDONYMIZATION ──────────────────────────────────────────────
# Secret salt for HMAC-SHA256 phone hash generation (minimum 32 characters).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_SALT=replace-with-a-random-salt-for-phone-hash-32chars-minimum

# ── 5. ADMIN AUTHENTICATION & JWT ─────────────────────────────────────────────
# Secret key for signing admin authentication JWTs (minimum 32 characters).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-super-secret-jwt-signing-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Brute-force lockout parameters
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── 6. AUTOMATED HOROSCOPE SCHEDULER & BATCH DISPATCH ─────────────────────────
# Dedicated pre-shared secret token for triggering the batch dispatch endpoint:
# POST /api/v1/schedules/daily-horoscopes/dispatch with Header 'Authorization: Bearer <token>'
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SCHEDULER_SECRET_TOKEN=replace-with-a-dedicated-scheduler-secret-token

# In-process background scheduler (keep false in multi-worker containers; invoke via host cron)
ENABLE_BACKGROUND_SCHEDULER=false
SCHEDULER_CHECK_INTERVAL_SECONDS=300

# ── 7. DEFERRED INTEGRATION: META WHATSAPP CLOUD API ──────────────────────────
# Leave as placeholders until you complete Meta Developer verification.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token-for-meta-webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_DAILY_HOROSCOPE=daily_horoscope_update
WHATSAPP_USE_TEMPLATES_FOR_PROACTIVE=true

# ── 8. DEFERRED INTEGRATION: OPENAI NATURAL LANGUAGE SYNTHESIS ────────────────
# Leave as placeholder until ready. When unset, deterministic astrology engine runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 9. OPTIONAL: REDIS CACHE (GRACEFUL FALLBACK ACTIVE) ───────────────────────
# When unset, in-memory deduplication and caching are used.
REDIS_URL=

# ── 10. CURATED ASTROLOGY KNOWLEDGE RAG ───────────────────────────────────────
# Keep disabled until reviewed knowledge corpus is ingested.
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_CONTEXT_MAX_CHARS=9000
RAG_ENABLE_HYBRID_SEARCH=false
MEMORY_ENABLED=false
