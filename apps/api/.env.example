# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection URLs
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/astrology_dev
DATABASE_SYNC_URL=postgresql+psycopg://postgres@localhost:5432/astrology_dev

# Connection Pooling
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Security: Field-Level Encryption (AES-256-GCM)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_PRIMARY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_SECONDARY_KEYS={}

# Security: Admin JWT Secret (Minimum 32 characters)
JWT_SECRET_KEY=super-secret-jwt-key-with-minimum-32-characters-required-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Identity Pseudonymization Salt (Minimum 16 characters)
PHONE_HASH_SALT=default-phone-hash-salt-32-chars-long-minimum

# Brute Force Protection
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# WhatsApp Cloud API (Meta for Developers)
# From Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_VERIFY_TOKEN=astrology-whatsapp-verify-token-dev
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_DAILY_HOROSCOPE=daily_horoscope_update
WHATSAPP_USE_TEMPLATES_FOR_PROACTIVE=true

# Automated Scheduler & Dispatch Security
# Dedicated pre-shared secret for Cloud Scheduler / external cron
SCHEDULER_SECRET_TOKEN=your_dedicated_scheduler_secret_token_here
ENABLE_BACKGROUND_SCHEDULER=false
SCHEDULER_CHECK_INTERVAL_SECONDS=300

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Temporary State / Redis (Optional - in-memory deduplication fallback is active)
REDIS_URL=redis://localhost:6379/0


# Curated astrology knowledge RAG (off until a reviewed corpus has been ingested)
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_CONTEXT_MAX_CHARS=9000
RAG_ENABLE_HYBRID_SEARCH=false
# User memory remains disabled until consent-gated integration is implemented.
MEMORY_ENABLED=false
